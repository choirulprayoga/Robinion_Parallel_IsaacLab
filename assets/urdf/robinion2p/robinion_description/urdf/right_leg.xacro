      </collision>

      <inertial>
        <origin xyz="-0.010643 -0.024500 -0.094743" rpy="0.00 0.00 0.00"/>
        <mass value="0.06"/>
        <inertia 
          ixx="0.000255" ixy="0.000000" ixz="0.000004" 
          iyy="0.000220" iyz="0.000000" 
          izz="0.000043"/>
      </inertial>
    </link>

    <joint name="right_knee_pitch_joint" type="revolute">
      <parent link="right_front_thigh_pitch_link"/>
      <child link="right_knee_pitch_link"/>
      <origin xyz="0.0 0.0 -0.2" rpy="0.0 0.0 0.0"/>
