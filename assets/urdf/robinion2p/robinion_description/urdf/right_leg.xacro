        <inertia 
          ixx="0.000255" ixy="0.000003" ixz="0.000004" 
          iyy="0.000220" iyz="0.000000" 
          izz="0.000043"/>
      </inertial>
    </link>

    <joint name="right_back_thigh_pitch_joint" type="revolute">
