<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="right_leg" params="parent">

    <joint name="right_hip_yaw_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="right_hip_yaw_link"/>
      <origin xyz="0.0 -0.055 0.0" rpy="0.0 0.0 0.0"/>
      <axis xyz="0 0 1"/>
      <limit velocity="4.82" effort="4.1" lower="${-pi*0.5}" upper="${pi*0.5}"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <link name="right_hip_yaw_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://robinion_description/meshes/right_hip_yaw_visual.stl"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0.002875 0.0 -0.003" rpy="0.0 0.0 0.0"/>
        <geometry>
          <box size="0.096 0.035 0.006" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.002613 0.000000 -0.016031" rpy="0.0 0.0 0.0"/>
        <mass value="0.048671"/>
        <inertia 
          ixx="0.000020" ixy="0.000000" ixz="0.000000" 
          iyy="0.000089" iyz="0.000000" 
          izz="0.000080"/>
      </inertial>
    </link>

    <joint name="right_hip_roll_joint" type="revolute">
      <parent link="right_hip_yaw_link"/>
      <child link="right_hip_roll_pitch_link"/>
      <origin xyz="0.047875 0.0 -0.05" rpy="0.0 0.0 0.0"/>
      <axis xyz="1 0 0"/>
      <limit velocity="4.08" effort="9.9" lower="${-pi*0.5}" upper="${pi*0.5}"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <link name="right_hip_roll_pitch_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://robinion_description/meshes/right_hip_roll_pitch_visual.stl"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="-0.045 0.0 -0.0155" rpy="0.0 0.0 0.0"/>
        <geometry>
          <box size="0.08 0.0335 0.0645" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="-0.044839 0.000311 -0.015111" rpy="0.0 0.0 0.0"/>
        <mass value="0.467377"/>
        <inertia 
          ixx="0.000198" ixy="0.000003" ixz="0.000001" 
          iyy="0.000406" iyz="0.000000" 
          izz="0.000326"/>
      </inertial>
    </link>

    <joint name="right_front_thigh_pitch_joint" type="revolute">
      <parent link="right_hip_roll_pitch_link"/>
      <child link="right_front_thigh_pitch_link"/>
      <origin xyz="-0.0245 0.0245 0.0" rpy="0.0 0.0 0.0"/>
      <axis xyz="0 1 0"/>
      <limit velocity="4.08" effort="19.8" lower="${-pi*0.5}" upper="${pi*0.5}"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <link name="right_front_thigh_pitch_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://robinion_description/meshes/right_thigh_visual.stl"/>
