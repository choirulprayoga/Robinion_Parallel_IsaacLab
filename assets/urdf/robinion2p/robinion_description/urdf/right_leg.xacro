      <child link="right_foot_roll_link"/>
      <origin xyz="0.0245 -0.02425 0.0" rpy="0.0 0.0 0.0"/>
      <axis xyz="1 0 0"/>
      <limit velocity="4.08" effort="9.9" lower="${-pi*0.5}" upper="${pi*0.5}"/>
