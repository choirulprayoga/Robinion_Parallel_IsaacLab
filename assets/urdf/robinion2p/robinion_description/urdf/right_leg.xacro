    <joint name="right_ankle_pitch_joint" type="revolute">
      <parent link="right_front_shin_pitch_link"/>
      <child link="right_ankle_roll_pitch_link"/>
      <origin xyz="0.0 0.0 -0.2" rpy="0.0 0.0 0.0"/>
