<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="head" params="parent">

    <joint name="head_yaw_joint" type="revolute">
      <parent link="${parent}"/>
      <child link="head_yaw_link"/>
      <origin xyz="-0.0125 -0.0245 0.183051" rpy="0.0 0.0 0.0"/>
      <axis xyz="0 0 1"/>
      <limit velocity="4.82" effort="4.1" lower="${-pi*0.5}" upper="${pi*0.5}"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <link name="head_yaw_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://robinion_description/meshes/head_yaw_visual.stl"/>
        </geometry>
      </visual>

      <inertial>
        <origin xyz="0.000000 0.000000 0.015679" rpy="0.0 0.0 0.0"/>
        <mass value="0.017180"/>
        <inertia
          ixx="0.000009" ixy="0.000000" ixz="0.000000"
          iyy="0.000005" iyz="0.000000"
          izz="0.000006"/>
      </inertial>
    </link>

    <joint name="head_pitch_joint" type="revolute">
      <parent link="head_yaw_link"/>
      <child link="head_pitch_link"/>
      <origin xyz="0.000 0.019 0.047" rpy="0.0 0.0 0.0"/>
      <axis xyz="0 -1 0"/>
      <limit velocity="4.82" effort="4.1" lower="${-pi*0.5}" upper="${pi*0.5}"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <link name="head_pitch_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
          <mesh filename="package://robinion_description/meshes/head_pitch_visual.stl"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0.0 -0.019 0.054" rpy="0.0 0.0 0.0"/>
        <geometry>
          <box size="0.04 0.09 0.028" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.000985 -0.018216 0.022305" rpy="0.0 0.0 0.0"/>
        <mass value="0.164500"/>
        <inertia
          ixx="0.000115" ixy="0.000000" ixz="0.000005"
          iyy="0.000092" iyz="0.000001"
          izz="0.000047"/>
      </inertial>
    </link>

    <joint name="cam_fixed_joint" type="fixed">
      <parent link="head_pitch_link"/>
      <child link="cam_link"/>
      <origin xyz="0.019 -0.019 0.054" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="cam_link"/>

  </xacro:macro>

</robot>